// ======================================================
// Peak Stagger — APS Demand Effect
// Uses canonical data/ops/daily-performance.json
// ======================================================

type DailyPerformanceRecord = {
  date: string;
  aps?: {
    onPeakDay?: boolean;
    onPeakDemandKW?: number | null;
    hourlyDemand?: {
      demand4to5KW?: number | null;
      demand5to6KW?: number | null;
      demand6to7KW?: number | null;
    };
  };
  hvacOverlap?: {
    overlap4to5Minutes?: number | null;
    overlap5to6Minutes?: number | null;
    overlap6to7Minutes?: number | null;
  };
  front?: {
    peakRuntimeMinutes?: number | null;
    temp7PM?: number | null;
  };
};

type DailyPerformanceSnapshot = {
  records?: DailyPerformanceRecord[];
};

type DemandEffectStats = {
  days: number;
  overlap5to6Total: number;
  overlap5to6Count: number;
  aps5to6Total: number;
  aps5to6Count: number;
  apsPeakTotal: number;
  apsPeakCount: number;
  front5to6Total: number;
  front5to6Count: number;
  hall5to6Total: number;
  hall5to6Count: number;
  front7PMTotal: number;
  front7PMCount: number;
};

function emptyDemandEffectStats():
  DemandEffectStats {
  return {
    days: 0,
    overlap5to6Total: 0,
    overlap5to6Count: 0,
    aps5to6Total: 0,
    aps5to6Count: 0,
    apsPeakTotal: 0,
    apsPeakCount: 0,
    front5to6Total: 0,
    front5to6Count: 0,
    hall5to6Total: 0,
    hall5to6Count: 0,
    front7PMTotal: 0,
    front7PMCount: 0,
  };
}

function addNullable(
  value: number | null | undefined,
  add: (value: number) => void
) {
  if (
    value !== null &&
    value !== undefined &&
    Number.isFinite(value)
  ) {
    add(value);
  }
}

function averageFromCount(
  total: number,
  count: number
): number | null {
  return count > 0
    ? total / count
    : null;
}

function displayKW(
  value: number | null
): string {
  return value === null
    ? "--"
    : `${value.toFixed(2)}kW`;
}

function displayDegree(
  value: number | null
): string {
  return value === null
    ? "--"
    : `${value.toFixed(1)}°`;
}

const dailyPerformancePath =
  path.join(
    process.cwd(),
    "data/ops/daily-performance.json"
  );

if (fs.existsSync(dailyPerformancePath)) {
  const dailyPerformance =
    JSON.parse(
      fs.readFileSync(
        dailyPerformancePath,
        "utf8"
      )
    ) as DailyPerformanceSnapshot;

  const dailyRecords =
    Array.isArray(dailyPerformance.records)
      ? dailyPerformance.records
      : [];

  const dailyByDate =
    new Map(
      dailyRecords.map(
        (record) => [
          record.date,
          record,
        ]
      )
    );

  const baselineDemandStats =
    emptyDemandEffectStats();

  const staggerDemandStats =
    emptyDemandEffectStats();

  for (const date of commonDates) {
    if (date < PEAK_75_START) {
      continue;
    }

    const [year, month, day] =
      date.split("-").map(Number);

    const weekdayIndex =
      new Date(
        Date.UTC(
          year,
          month - 1,
          day
        )
      ).getUTCDay();

    if (
      weekdayIndex === 0 ||
      weekdayIndex === 6
    ) {
      continue;
    }

    const daily =
      dailyByDate.get(date);

    if (
      !daily ||
      daily.aps?.onPeakDay !== true
    ) {
      continue;
    }

    const frontResult =
      frontAnalyzer.analyzeDate(date);

    const hallResult =
      hallAnalyzer.analyzeDate(date);

    const stats =
      date < STAGGER_START
        ? baselineDemandStats
        : staggerDemandStats;

    stats.days++;

    addNullable(
      daily.hvacOverlap
        ?.overlap5to6Minutes,
      (value) => {
        stats.overlap5to6Total += value;
        stats.overlap5to6Count++;
      }
    );

    addNullable(
      daily.aps.hourlyDemand
        ?.demand5to6KW,
      (value) => {
        stats.aps5to6Total += value;
        stats.aps5to6Count++;
      }
    );

    addNullable(
      daily.aps.onPeakDemandKW,
      (value) => {
        stats.apsPeakTotal += value;
        stats.apsPeakCount++;
      }
    );

    addNullable(
      frontResult.runtime5to6Minutes,
      (value) => {
        stats.front5to6Total += value;
        stats.front5to6Count++;
      }
    );

    addNullable(
      hallResult.runtime5to6Minutes,
      (value) => {
        stats.hall5to6Total += value;
        stats.hall5to6Count++;
      }
    );

    addNullable(
      frontResult.temp7PM,
      (value) => {
        stats.front7PMTotal += value;
        stats.front7PMCount++;
      }
    );
  }

  const baselineOverlap5to6 =
    averageFromCount(
      baselineDemandStats
        .overlap5to6Total,
      baselineDemandStats
        .overlap5to6Count
    );

  const staggerOverlap5to6 =
    averageFromCount(
      staggerDemandStats
        .overlap5to6Total,
      staggerDemandStats
        .overlap5to6Count
    );

  const baselineAPS5to6 =
    averageFromCount(
      baselineDemandStats
        .aps5to6Total,
      baselineDemandStats
        .aps5to6Count
    );

  const staggerAPS5to6 =
    averageFromCount(
      staggerDemandStats
        .aps5to6Total,
      staggerDemandStats
        .aps5to6Count
    );

  const baselineAPSPeak =
    averageFromCount(
      baselineDemandStats
        .apsPeakTotal,
      baselineDemandStats
        .apsPeakCount
    );

  const staggerAPSPeak =
    averageFromCount(
      staggerDemandStats
        .apsPeakTotal,
      staggerDemandStats
        .apsPeakCount
    );

  const baselineDemandFront5to6 =
    averageFromCount(
      baselineDemandStats
        .front5to6Total,
      baselineDemandStats
        .front5to6Count
    );

  const staggerDemandFront5to6 =
    averageFromCount(
      staggerDemandStats
        .front5to6Total,
      staggerDemandStats
        .front5to6Count
    );

  const baselineDemandHall5to6 =
    averageFromCount(
      baselineDemandStats
        .hall5to6Total,
      baselineDemandStats
        .hall5to6Count
    );

  const staggerDemandHall5to6 =
    averageFromCount(
      staggerDemandStats
        .hall5to6Total,
      staggerDemandStats
        .hall5to6Count
    );

  const baselineDemandFront7PM =
    averageFromCount(
      baselineDemandStats
        .front7PMTotal,
      baselineDemandStats
        .front7PMCount
    );

  const staggerDemandFront7PM =
    averageFromCount(
      staggerDemandStats
        .front7PMTotal,
      staggerDemandStats
        .front7PMCount
    );

  console.log("");
  console.log(
    "========================================"
  );
  console.log(
    " PEAK STAGGER — APS DEMAND EFFECT"
  );
  console.log(
    ` STAGGER ACTIVE: ${STAGGER_START}`
  );
  console.log(
    "========================================"
  );
  console.log("");

  console.log(
    "                    BASELINE     STAGGER"
  );
  console.log(
    "----------------------------------------"
  );

  console.log(
    `Days                ${String(
      baselineDemandStats.days
    ).padStart(6)}      ${String(
      staggerDemandStats.days
    ).padStart(6)}`
  );

  console.log(
    `5–6 HVAC Overlap    ${displayMinutes(
      baselineOverlap5to6
    ).padStart(6)}      ${displayMinutes(
      staggerOverlap5to6
    ).padStart(6)}`
  );

  console.log(
    `5–6 APS Demand      ${displayKW(
      baselineAPS5to6
    ).padStart(6)}      ${displayKW(
      staggerAPS5to6
    ).padStart(6)}`
  );

  console.log(
    `4–7 APS Peak        ${displayKW(
      baselineAPSPeak
    ).padStart(6)}      ${displayKW(
      staggerAPSPeak
    ).padStart(6)}`
  );

  console.log(
    `Front 5–6 Runtime   ${displayMinutes(
      baselineDemandFront5to6
    ).padStart(6)}      ${displayMinutes(
      staggerDemandFront5to6
    ).padStart(6)}`
  );

  console.log(
    `Hall 5–6 Runtime    ${displayMinutes(
      baselineDemandHall5to6
    ).padStart(6)}      ${displayMinutes(
      staggerDemandHall5to6
    ).padStart(6)}`
  );

  console.log(
    `Front 7 PM Temp     ${displayDegree(
      baselineDemandFront7PM
    ).padStart(6)}      ${displayDegree(
      staggerDemandFront7PM
    ).padStart(6)}`
  );

  console.log("");

  console.log(
    `Overlap change        : ${percentChange(
      baselineOverlap5to6,
      staggerOverlap5to6
    )}`
  );

  console.log(
    `5–6 APS demand change : ${percentChange(
      baselineAPS5to6,
      staggerAPS5to6
    )}`
  );

  console.log(
    `4–7 APS peak change   : ${percentChange(
      baselineAPSPeak,
      staggerAPSPeak
    )}`
  );

  console.log("");
} else {
  console.log("");
  console.log(
    "========================================"
  );
  console.log(
    " PEAK STAGGER — APS DEMAND EFFECT"
  );
  console.log(
    "========================================"
  );
  console.log("");
  console.log(
    "daily-performance.json not found."
  );
  console.log(
    "Run: npx tsx scripts/daily-performance.ts"
  );
  console.log("");
}

// ======================================================
// Home Ops Context
// ======================================================

const contextEvents =
  getContextForDate(TARGET_DATE);

if (contextEvents.length > 0) {
  console.log("");
  console.log(
    "========================================"
  );
  console.log(
    "       HOME OPS CONTEXT"
  );
  console.log(
    "========================================"
  );

  for (const event of contextEvents) {
    console.log("");
    console.log(
      `⚠ ${event.tags.join(", ")}`
    );

    console.log(event.description);

    console.log("");
    console.log(
      `Analysis note: ${event.analysisImpact}`
    );
  }

  console.log("");
}
// ======================================================
// Active Home Ops Countermeasures
// ======================================================

const activeCountermeasures =
  getCountermeasuresForDate(TARGET_DATE);

if (activeCountermeasures.length > 0) {
  console.log("");
  console.log(
    "========================================"
  );
  console.log(
    "       ACTIVE COUNTERMEASURES"
  );
  console.log(
    "========================================"
  );
  console.log("");

  for (const item of activeCountermeasures) {
    console.log(`✓ ${item.name}`);
    console.log(
      `  Active since ${item.startDate}`
    );

    if (item.before && item.after) {
      console.log(
        `  ${item.before} → ${item.after}`
      );
    }

    console.log("");
  }
}