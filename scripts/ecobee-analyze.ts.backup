      baselineStats.overlap6to7,
      baselineStats.days
    )
  ).padStart(6)}      ${displayMinutes(
    average(
      staggerStats.overlap6to7,
      staggerStats.days
    )
  ).padStart(6)}`
);
console.log(
  `Front 7 PM Temp     ${displayTempAverage(
