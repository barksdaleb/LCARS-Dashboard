);

console.log(
  `Overlap 5–6 PM      ${displayMinutes(
    average(
      baselineStats.overlap5to6,
      baselineStats.days
    )
  ).padStart(6)}      ${displayMinutes(
    average(
      staggerStats.overlap5to6,
